(function(){var root=fl.scriptURI.substring(0,fl.scriptURI.lastIndexOf("/")+1);var doc=fl.openDocument(root+"Motion-final.fla");if(!doc){FLfile.write(root+"animate-final.txt","OPEN_FAILED");return;}var t=doc.getTimeline();var lines=["document="+doc.name,"frameCount="+t.frameCount];for(var l=0;l<t.layers.length;l++){var layer=t.layers[l];var starts=[];for(var f=0;f<layer.frames.length;f++){var frame=layer.frames[f];if(frame.startFrame===f){starts.push(f+":"+frame.duration+":"+frame.tweenType+":"+frame.tweenEasing);}}lines.push("layer="+layer.name+" keys="+starts.join(","));}for(var i=0;i<5;i++){var f=[0,10,20,30,40][i];t.currentFrame=f;doc.exportPNG(root+"final-frame-"+f+".png",true,true);}fl.saveDocument(doc,root+"Motion-final-saved.fla");t.currentFrame=0;var el=t.layers[0].frames[0].elements[0];var m=el.matrix;m.tx+=10;el.matrix=m;lines.push("edited_tx="+m.tx);fl.saveDocument(doc,root+"Motion-final-edited.fla");FLfile.write(root+"animate-final.txt",lines.join("\n"));doc.close(false);})();
<NavigationView xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Navigation"
 PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" OpenPaneLength="220">
 <NavigationView.MenuItems>
  <NavigationViewItem x:Name="PackItem" Content="打包" Tag="pack" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem>
  <NavigationViewItem x:Name="UnpackItem" Content="解包（逆向）" Tag="unpack"><NavigationViewItem.Icon><FontIcon Glyph="&#xE896;"/></NavigationViewItem.Icon></NavigationViewItem>
  <NavigationViewItem x:Name="TvItem" Content="TV → PC" Tag="tv"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;"/></NavigationViewItem.Icon></NavigationViewItem>
 </NavigationView.MenuItems>
 <NavigationView.PaneFooter>
  <!-- Match the native pane's 120 ms transition without reflowing the text. -->
  <StackPanel x:Name="FormatPanel" Width="184" HorizontalAlignment="Left" Margin="18,0,18,24" Spacing="8" IsHitTestVisible="False">
   <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.12"/></StackPanel.OpacityTransition>
  <TextBlock Text="格式" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  <TextBlock x:Name="FormatText" Text="FLA → reanim.compiled" TextWrapping="Wrap"/>
  <TextBlock x:Name="FormatDetail" Text="经典动画 · 分组 · 骨骼" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  </StackPanel>
 </NavigationView.PaneFooter>
 <Grid Padding="32,24" Background="{ThemeResource LayerFillColorDefaultBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Spacing="8"><TextBlock Text="FLA Reanim Compiler" Style="{ThemeResource TitleTextBlockStyle}"/>
   <TextBlock x:Name="Subtitle" Text="把 FLA 编译为游戏动画，或还原成可编辑的 FLA" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,18,0,0">
   <Button x:Name="PickButton" Content="选择文件" Style="{StaticResource AccentButtonStyle}"/>
   <Button x:Name="PickFolderButton" Content="选择文件夹" Visibility="Collapsed"/>
   <Button x:Name="ClearButton" Content="清空日志"/>
   <CheckBox x:Name="PlusCheck" Content="增强编译" ToolTipService.ToolTip="保留分组、骨骼和独立部件；IK 文件自动启用"/>
   <CheckBox x:Name="StrictCheck" Content="精确采样" Visibility="Collapsed" ToolTipService.ToolTip="逆向时使用更严格的曲线误差限制，会保留更多关键帧。默认优先重建便于编辑的补间。"/>
  </StackPanel>
  <Border Grid.Row="3" x:Name="DropSurface" AllowDrop="True" Padding="24" Height="156" Margin="0,18,0,0" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
   <StackPanel VerticalAlignment="Center" Spacing="8">
    <TextBlock x:Name="DropTitle" Text="拖放 .fla / XFL 到这里" Style="{ThemeResource SubtitleTextBlockStyle}"/>
    <TextBlock x:Name="DropHint" Text="支持多个文件。已有输出会保留，请使用新文件名。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <ProgressBar x:Name="Progress" Opacity="0" IsIndeterminate="False" Height="4" Margin="0,8,0,0">
     <ProgressBar.OpacityTransition><ScalarTransition Duration="0:0:0.12"/></ProgressBar.OpacityTransition>
    </ProgressBar>
   </StackPanel>
  </Border>
  <Grid Grid.Row="4" RowSpacing="10" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="日志" Style="{ThemeResource SubtitleTextBlockStyle}"/>
   <TextBox Grid.Row="1" x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" PlaceholderText="拖入文件开始转换"/>
  </Grid>
  <!-- A clipped viewport grows in the layout; the notice never slides or overlaps the drop area. -->
  <ScrollViewer Grid.Row="2" x:Name="StatusPopup" Height="0" IsHitTestVisible="False" IsTabStop="False" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
   <Grid x:Name="StatusContent" Margin="0,18,0,0" Opacity="0">
   <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Padding="0,0,36,0"/>
   <Button x:Name="DismissStatus" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Padding="8" MinWidth="32" MinHeight="32" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="关闭" AutomationProperties.Name="关闭通知">
    <FontIcon Glyph="&#xE711;" FontSize="12"/>
   </Button>
   </Grid>
  </ScrollViewer>
 </Grid>
</NavigationView>
